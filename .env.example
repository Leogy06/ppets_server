# Local placeholders only. Copy to .env and replace before running.
NODE_ENV=development
PORT=4001
DATABASE_URL=mysql://ppets:replace-with-local-password@localhost:3307/ppets
CLIENT_BASEURL=http://localhost:3002
SESSION_SECRET=replace-with-at-least-32-random-characters
